# Copy to .env and fill in real values. NEVER commit a real .env file.
# All values below are placeholders — replace "change-me" with real secrets.

# Port the server listens on
PORT=3001

# REQUIRED — the server refuses to start without it.
# A long random string, e.g. generated with: openssl rand -hex 32
JWT_SECRET=change-me

# Database connection — use ONE of these two options:
# Option A: full connection string (preferred for Supabase / hosted Postgres)
DATABASE_URL=change-me
# SUPABASE_URL=change-me

# Option B: individual parameters (used only when no connection string is set)
# DB_HOST=change-me
# DB_PORT=5432
# DB_NAME=change-me
# DB_USER=change-me
# DB_PASSWORD=change-me

# Set to "true" only if the database requires SSL (e.g. some hosted providers).
# Otherwise SSL is off.
DB_SSL=false

# Password for the default seed admin created by `npm run init-db`.
# REQUIRED for the seed admin to be created at all: if this is missing, the
# script creates the tables and the seed company but refuses to create the
# admin user. Change it immediately after first login.
SEED_ADMIN_PASSWORD=change-me

# CORS — only needed when the frontend is opened from an origin other than
# the local dev ones (e.g. a forwarded Codespaces URL in the Docker demo).
# CORS_ORIGINS: comma-separated allowlist, e.g. https://example.app.github.dev
# CORS_ALLOW_ALL_ORIGINS=true: reflect any origin (DEMO ONLY — never in production).
# When neither is set, only http://localhost:5173, https://localhost:5173 and
# http://localhost:3000 are allowed.
# CORS_ORIGINS=
# CORS_ALLOW_ALL_ORIGINS=false

# NODE_ENV=development
